---
import { getProfile, getProjects } from "@portfolio/data-access";
import { sanitizeUrl } from "../utils/security";

const profile = await getProfile();
const projects = await getProjects();

const safeGithub = sanitizeUrl(profile.githubUrl);
const safeLinkedin = sanitizeUrl(profile.linkedinUrl);
const safeEmail = sanitizeUrl(`mailto:${profile.email}`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{profile.name} — {profile.role}</title>
    <meta name="description" content={`${profile.name} — ${profile.headline}`} />
    <style>
      :root {
        --bg-canvas: #f8fafc;
        --surface: #ffffff;
        --surface-subtle: #f1f5f9;
        --border-light: #e2e8f0;
        --border-strong: #cbd5e1;
        --text-primary: #0f172a;
        --text-secondary: #334155;
        --text-muted: #64748b;
        --accent: #1e3a8a;
        --accent-hover: #1d4ed8;
        --accent-soft: #eff6ff;
        --status-live: #059669;
        --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-stack);
        color: var(--text-primary);
        background-color: var(--bg-canvas);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        padding: 3rem 1.5rem;
      }

      .skip-link {
        position: absolute;
        top: -9999px;
        left: 1rem;
        background: var(--text-primary);
        color: #ffffff;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        font-size: 0.875rem;
        z-index: 100;
        text-decoration: none;
      }

      .skip-link:focus {
        top: 1rem;
      }

      .container {
        max-width: 720px;
        margin: 0 auto;
      }

      /* Architectural Status Dossier */
      .status-line {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        font-size: 0.8125rem;
        color: var(--text-secondary);
        background: var(--surface);
        border: 1px solid var(--border-light);
        padding: 0.375rem 0.875rem;
        border-radius: 6px;
        margin-bottom: 2rem;
      }

      .status-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: var(--status-live);
        box-shadow: 0 0 0 2px rgba(5, 150, 105, 0.2);
        display: inline-block;
      }

      /* Hero Section */
      header.hero {
        margin-bottom: 3.5rem;
      }

      .headline-name {
        font-size: 2.5rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.15;
        color: var(--text-primary);
        margin-bottom: 0.35rem;
      }

      .headline-role {
        font-size: 1.125rem;
        font-weight: 500;
        color: var(--text-secondary);
        margin-bottom: 1rem;
      }

      .headline-bio {
        font-size: 1.05rem;
        color: var(--text-secondary);
        max-width: 62ch;
        line-height: 1.65;
        margin-bottom: 1.75rem;
      }

      .contact-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        font-size: 0.875rem;
      }

      .contact-link {
        color: var(--accent);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.15s ease;
      }

      .contact-link:hover {
        color: var(--accent-hover);
        text-decoration: underline;
      }

      .contact-link:focus-visible {
        outline: 2px solid var(--accent-hover);
        outline-offset: 2px;
        border-radius: 2px;
      }

      /* Section Divider */
      .section-divider {
        height: 1px;
        background-color: var(--border-light);
        margin-bottom: 2.5rem;
      }

      /* Projects Architecture */
      .section-heading {
        font-size: 1.125rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--text-primary);
        margin-bottom: 1.75rem;
      }

      .projects-ledger {
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }

      .project-entry {
        background: var(--surface);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 1.5rem;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .project-entry:hover {
        border-color: var(--border-strong);
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);
      }

      .project-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 0.5rem;
        gap: 1rem;
      }

      .project-title {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--text-primary);
      }

      .project-desc {
        font-size: 0.9375rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin-bottom: 1rem;
      }

      .tech-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
        margin-bottom: 1.25rem;
      }

      .tech-tag {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--text-muted);
        background: var(--surface-subtle);
        padding: 0.2rem 0.55rem;
        border-radius: 4px;
        border: 1px solid var(--border-light);
      }

      .project-actions {
        display: flex;
        gap: 1.25rem;
        font-size: 0.875rem;
      }

      .action-link {
        color: var(--accent);
        text-decoration: none;
        font-weight: 500;
      }

      .action-link:hover {
        text-decoration: underline;
        color: var(--accent-hover);
      }

      .action-link:focus-visible {
        outline: 2px solid var(--accent-hover);
        outline-offset: 2px;
        border-radius: 2px;
      }

      footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border-light);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.8125rem;
        color: var(--text-muted);
      }

      @media (max-width: 640px) {
        body {
          padding: 2rem 1rem;
        }

        .headline-name {
          font-size: 2rem;
        }

        .project-header {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.25rem;
        }

        footer {
          flex-direction: column;
          gap: 0.5rem;
          align-items: flex-start;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <div class="container">
      <div class="status-line" role="status" aria-label="Edge node status">
        <span class="status-indicator" aria-hidden="true"></span>
        <span>Edge runtime: Cloudflare Workers · Zero database queries per visitor</span>
      </div>

      <header class="hero">
        <h1 class="headline-name">{profile.name}</h1>
        <p class="headline-role">{profile.role}</p>
        <p class="headline-bio">{profile.headline}</p>

        <nav class="contact-strip" aria-label="Direct contact and professional links">
          {safeEmail && (
            <a href={safeEmail} class="contact-link">
              {profile.email}
            </a>
          )}
          {safeGithub && (
            <a href={safeGithub} target="_blank" rel="noopener noreferrer" class="contact-link">
              GitHub
            </a>
          )}
          {safeLinkedin && (
            <a href={safeLinkedin} target="_blank" rel="noopener noreferrer" class="contact-link">
              LinkedIn
            </a>
          )}
        </nav>
      </header>

      <div class="section-divider" role="separator"></div>

      <main id="main-content">
        <section aria-labelledby="systems-heading">
          <h2 id="systems-heading" class="section-heading">Featured Systems & Projects</h2>
          <div class="projects-ledger">
            {
              projects.map((project) => {
                const demo = sanitizeUrl(project.demoUrl);
                const repo = sanitizeUrl(project.repoUrl);
                return (
                  <article class="project-entry">
                    <div class="project-header">
                      <h3 class="project-title">{project.title}</h3>
                    </div>
                    <p class="project-desc">{project.description}</p>
                    <div class="tech-tags" aria-label="Technologies used">
                      {project.techStack.map((tech) => (
                        <span class="tech-tag">{tech}</span>
                      ))}
                    </div>
                    {(demo || repo) && (
                      <div class="project-actions">
                        {demo && (
                          <a href={demo} target="_blank" rel="noopener noreferrer" class="action-link">
                            Explore system
                          </a>
                        )}
                        {repo && (
                          <a href={repo} target="_blank" rel="noopener noreferrer" class="action-link">
                            Source repository
                          </a>
                        )}
                      </div>
                    )}
                  </article>
                );
              })
            }
          </div>
        </section>
      </main>

      <footer>
        <span>{profile.name} · {profile.location}</span>
        <span>Built with Astro, Cloudflare Workers & KV</span>
      </footer>
    </div>
  </body>
</html>
